{
  "name": "xsignon-autoheal",
  "version": "0.12.0",
  "description": "Free, self-hosted AI agent that fixes failing Playwright, pytest-playwright and Cypress tests in GitHub Actions, GitLab CI, CircleCI or on your machine, with your own AI key. Anti-cheat guard, stability proof, evidence-first PRs.",
  "author": "xsignon-secure (https://github.com/xsignon-secure)",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/xsignon-secure/AutoHeal-AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsignon-secure/AutoHeal-AI.git"
  },
  "bugs": {
    "url": "https://github.com/xsignon-secure/AutoHeal-AI/issues"
  },
  "keywords": [
    "playwright",
    "cypress",
    "pytest",
    "e2e",
    "gitlab-ci",
    "circleci",
    "self-healing",
    "ai-agent",
    "flaky-tests",
    "github-action",
    "mcp",
    "test-automation",
    "free",
    "open-source"
  ],
  "bin": {
    "autoheal": "dist/cli.js",
    "xsignon-autoheal": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cypress": "./cypress/support.js",
    "./cypress/support": "./cypress/support.js",
    "./cypress/plugin": {
      "require": "./cypress/plugin.cjs",
      "import": "./cypress/plugin.mjs"
    },
    "./playwright": {
      "types": "./playwright/index.d.ts",
      "import": "./playwright/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "scripts",
    "publish",
    "command",
    "cypress",
    "action.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "playwright",
    "skills"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-dist": "npm run build && git diff --exit-code --stat -- dist",
    "test": "npm run build && node --test --test-reporter=spec test/*.test.mjs",
    "simulate": "npm run build && node simulation/run.mjs",
    "bench": "npm run build && node bench/run.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "playwright-e2e-mcp": "0.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
